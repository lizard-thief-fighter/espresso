{
  "version": 2,
  "particle": {
    "particleLimit": 8192,
    "cleanupStrategy": "PARALLEL_WITH_TICK",
    "parallelQueueRemoval": true,
    "parallelQueueEviction": true,
    "particleLightCache": true,
    "cullUnderwaterParticleType": true
  },
  "tick": {
    "animationTickMode": true,
    "particleAsyncMode": "SEQUENTIAL",
    "gpuOnlyAsyncParticleTick": true,
    "tickWeatherAsync": true,
    "deferredTextureTick": true,
    "failPerSecLimit": 5,
    "failBehavior": "RAISE_CRASH",
    "suppressCME": false,
    "syncAnimationClasses": [],
    "syncParticleClasses": []
  },
  "rendering": {
    "particleCulling": "SPHERE",
    "gpuAcceleration": true,
    "appendNewParticlesToRenderer": false,
    "computeExecutionStage": "LEVEL_RENDERING",
    "tickRendererOnMainThread": false,
    "cullWeathers": true
  },
  "valkyrienSkies": {
    "rainEffect": "STATIONARY",
    "fixParticleLights": true
  },
  "sable": {
    "fixParticleLights": true
  },
  "polytone": {
    "takeover": true,
    "asyncTick": true,
    "gpuOnlyAsyncTick": false,
    "gpuRendering": true
  },
  "create": {
    "rainEffect": "ALWAYS",
    "tickRainBlockingRange": 16
  },
  "mobile": {
    "multiDrawWorkaround": true
  }
}